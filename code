// # 초음파 센서 micros 버전
#define TRIGGER_HIGH() PORTD |= (1<<3)
#define TRIGGER_LOW() PORTD &= ~(1<<3)
#define ECHO (PIND & (1<<2))
void us_trigger()
{
	TRIGGER_HIGH();
	_delay_us(10);
	TRIGGER_LOW();
}
volatile uint16_t time = 0;
volatile uint8_t time_update_flag = 0;
uint32_t start_time = 0;
ISR(INT0_vect)
{
	uint32_t us = micros();
	if (ECHO)
	{ // rising edge
		start_time = us;
	}
	else
	{ // falling edge
		time = us - start_time;
		time_update_flag = 1;
	}
}
void us_init()
{
	DDRD |= (1 << 3); // trigger => out
	DDRD &= ~(1 << 2); // echo => in / int0

	// echo pin : ext int0
	EICRA |= (1 << ISC00); // mode:logical change
	EICRA &= ~(1 << ISC01);
	EIMSK |= (1 << INT0); // enable ext int0
}


// --------------------------------------- 실질적으로 추가한 구간 --------------------------------------------------

typedef struct
{
	uint16_t min_d, max_d;
	uint16_t freq;        // 톤 주파수
	uint16_t beep_on_ms;  // 소리 구간(ms)
	uint16_t beep_off_ms; // 무음 구간(ms)
} table;

const table patterns[6] = {{150,500,0,0,0}, {120,149,440,75,1500}, {80,119,440,75,1000}, {50,79,440,75,500}, {30,49,440,150,200}, {0,29,880,9999,0}};

uint8_t get_pattern_by_distance_hysteresis(uint16_t distance, uint8_t prev_pattern) // 중첩음 방지
{
    if (prev_pattern == 5 && distance <= 30) return 5;
    if (prev_pattern == 4 && distance >= 29 && distance <= 50) return 4;
    if (prev_pattern == 3 && distance >= 49 && distance <= 80) return 3;
    if (prev_pattern == 2 && distance >= 79 && distance <= 120) return 2;
    if (prev_pattern == 1 && distance >= 119 && distance <= 150) return 1;

    // 기본 거리 구간 적용
    if (distance < 30)  return 5;
    if (distance < 50)  return 4;
    if (distance < 80)  return 3;
    if (distance < 120) return 2;
    if (distance < 150) return 1;
    return 0;
}

int main()
{
	uart_init(9600);
	us_init();
	timer0_init();
	sei(); // 전역인터럽트 활성화

	us_trigger(); // 첫 측정

	uint8_t current_pattern_index = 0; // 현재 적용중인 패턴 인덱스
	uint8_t phase = 0; // 0: beep on, 1: beep off
	uint32_t phase_start = 0;
	uint16_t last_freq = 0;

	while (1)
	{
		if (time_update_flag)
		{
			time_update_flag = 0;
			us_trigger();

			uint16_t d = time * (0.0343 / 2 * 278.3 / 262);

			uint8_t pattern_index = get_pattern_by_distance_hysteresis(d, current_pattern_index);
			const table* pat = &patterns[pattern_index];

			// 패턴 변경 시 상태 리셋
			if (pattern_index != current_pattern_index)
			{
				current_pattern_index = pattern_index;
				phase = 0;
				phase_start = millis();
				last_freq = 0;
				tone_stop();
			}

			uint32_t now = millis();

			if (pat->freq == 0) // 무음
			{
				tone_stop();
				last_freq = 0;
			}
			else if (pat->beep_off_ms == 0) // 연속음
			{
				if (!isToneActive || last_freq != pat->freq)
				{
					tone(pat->freq);
					last_freq = pat->freq;
				}
			}
			else
			{
				if (phase == 0) // beep on
				{
					if (!isToneActive || last_freq != pat->freq)
					{
						tone(pat->freq);
						last_freq = pat->freq;
					}
					if (now - phase_start >= pat->beep_on_ms)
					{
						tone_stop();
						phase = 1;
						phase_start = now;
						last_freq = 0;
					}
				}
				else // beep off
				{
					tone_stop();
					if (now - phase_start >= pat->beep_off_ms)
					{
						phase = 0;
						phase_start = now;
					}
					last_freq = 0;
				}
			}
			char s[16];
			sprintf(s, "%d\n", d);
			uart_print(s);
		}
	}
}
